<%# LIFF SDKの読み込み %>
<script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
<%# reCAPTCHA v3の読み込み %>
<script src="https://www.google.com/recaptcha/api.js?render=<%= ENV['RECAPTCHA_SITE_KEY'] %>"></script>

<style>
  @keyframes winEntrance {
    0%   { opacity: 0; transform: scale(0.88) translateY(12px); }
    65%  { transform: scale(1.03) translateY(-3px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes emojiPop {
    0%   { transform: scale(0) rotate(-15deg); }
    60%  { transform: scale(1.3) rotate(8deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
  @keyframes shimmer {
    0%   { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  #win-card {
    animation: winEntrance 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  #win-emoji {
    display: inline-block;
    animation: emojiPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s both;
  }
  #win-title {
    background: linear-gradient(90deg, #713f12, #b45309, #713f12);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 2.5s linear 0.8s infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .entry-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.12s ease, opacity 0.12s ease, background-color 0.15s ease;
  }
  .entry-btn:active {
    transform: scale(0.97);
    opacity: 0.85;
  }
  .entry-btn .btn-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    flex-shrink: 0;
    animation: spin 0.7s linear infinite;
  }
  .entry-btn.loading {
    background-color: #059c43;
    cursor: not-allowed;
  }
  .entry-btn.loading .btn-spinner {
    display: block;
  }
</style>

<div style="max-width: 600px; margin: 0 auto; padding: 20px max(20px, env(safe-area-inset-right)) max(40px, calc(env(safe-area-inset-bottom) + 20px)) max(20px, env(safe-area-inset-left));">
  <% if @event.image.attached? %>
    <%= image_tag @event.image, style: "width: 100%; border-radius: 8px; margin-bottom: 20px;" %>
  <% end %>

  <h1 style="font-size: 24px; font-weight: bold; margin-bottom: 10px;"><%= @event.title %></h1>
  
  <div style="background-color: #f3f4f6; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
    <p style="margin: 0; font-size: 14px; color: #4b5563;">受付期間</p>
    <p style="margin: 5px 0 0 0; font-weight: bold;">
      <%= l @event.entry_start_at, format: :short %> 〜 <%= l @event.entry_end_at, format: :short %>
    </p>
    <p style="margin: 10px 0 0 0; font-size: 14px; color: #4b5563;">当選枠数</p>
    <p style="margin: 5px 0 0 0; font-weight: bold;"><%= @event.winner_count %> 名</p>
    <p style="margin: 10px 0 0 0; font-size: 14px; color: #4b5563;">抽選時間</p>
    <p style="margin: 5px 0 0 0; font-weight: bold;">
      <% if @event.scheduled? %>
        <%= l @event.lottery_scheduled_at, format: :short %>
      <% else %>
        応募締切と同時に抽選
      <% end %>
    </p>
  </div>

  <%# 応募受付中のみカウントダウンを表示 %>
  <% if @event.entry_start_at <= Time.current && Time.current < @event.entry_end_at %>
    <div id="countdown-bar" style="background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between;">
      <span style="font-size: 12px; color: #9a3412;">⏰ 応募締切まで</span>
      <span id="countdown-timer" style="font-size: 15px; font-weight: 700; color: #9a3412; font-variant-numeric: tabular-nums; letter-spacing: 0.03em;" data-deadline="<%= @event.entry_end_at.utc.iso8601 %>">--:--:--</span>
    </div>
  <% end %>

  <div style="margin-bottom: 30px; line-height: 1.6;">
    <%= simple_format(@event.description) %>
  </div>

  <%# ログイン状態によるボタンの切り替え（3段階） %>
  <% if current_user && current_user.line_uid.present? %>
    <%# プロフィールカード（LINE・SMS 両認証で共通表示） %>
    <div style="background-color: #f3f4f6; border-radius: 8px; padding: 15px; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
      <% if current_user.picture_url.present? %>
        <img src="<%= current_user.picture_url %>"
             alt="プロフィール画像"
             style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0;">
      <% else %>
        <div style="width: 48px; height: 48px; border-radius: 50%; background-color: #06C755; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <span style="color: #ffffff; font-weight: bold; font-size: 20px;"><%= current_user.display_name&.first %></span>
        </div>
      <% end %>
      <div>
        <p style="margin: 0; font-weight: bold; font-size: 15px;"><%= current_user.display_name %></p>
        <% if current_user.phone_verified? %>
          <p style="margin: 4px 0 0 0; font-size: 12px; color: #06C755;">● LINE・SMS認証済み</p>
        <% else %>
          <p style="margin: 4px 0 0 0; font-size: 12px; color: #06C755;">● LINEでログイン中</p>
        <% end %>
      </div>
    </div>

    <% if ENV['SMS_MOCK_MODE'] == 'true' && current_user.phone_verified? %>
      <%= button_to reset_for_demo_sms_verifications_path,
            method: :post,
            params: { event_token: @event.public_token },
            style: "background: none; border: none; padding: 0; margin-bottom: 8px; cursor: pointer;" do %>
        <span style="font-size: 11px; color: #9ca3af; text-decoration: underline;">【デモ用】SMS認証をリセットする</span>
      <% end %>
    <% end %>

    <% if current_user.phone_verified? %>
      <%# ③ LINE・SMS 両方完了 → 応募ボタン or 結果表示 %>
      <% my_entry = @event.entries.find_by(user: current_user) %>
      <% if my_entry %>
        <% if @event.already_drawn? %>
          <% if my_entry.win? %>
            <%# 当選 %>
            <div id="win-card" style="width: 100%; padding: 20px 15px; background-color: #fefce8; border: 2px solid #eab308; border-radius: 8px; text-align: center; box-sizing: border-box;">
              <p id="win-emoji" style="margin: 0 0 6px 0; font-size: 32px;">🎉</p>
              <p id="win-title" style="margin: 0; font-size: 18px; font-weight: bold;">おめでとうございます！ご当選です！</p>
              <% if @event.checkin_enabled? && my_entry.checkin_token.present? %>
                <p style="margin: 8px 0 12px 0; font-size: 13px; color: #92400e;">来店時に以下のQRコードをスタッフにご提示ください。</p>
                <div style="background-color: #fff; display: inline-block; padding: 12px; border-radius: 8px; margin-bottom: 8px;">
                  <%= raw RQRCode::QRCode.new(my_entry.checkin_token).as_svg(
                        color: "000", shape_rendering: "crispEdges",
                        module_size: 5, standalone: true, use_path: true
                      ) %>
                </div>
                <% if my_entry.checked_in? %>
                  <p style="margin: 4px 0 0; font-size: 12px; color: #15803d; font-weight: 600;">
                    ✓ チェックイン済み（<%= l my_entry.checked_in_at.in_time_zone('Asia/Tokyo'), format: :short %>）
                  </p>
                <% end %>
              <% else %>
                <p style="margin: 8px 0 0 0; font-size: 13px; color: #92400e;">抽選の結果、当選が決定しました。来店時にこの画面をご提示ください。</p>
              <% end %>
            </div>
          <% else %>
            <%# 落選 %>
            <div style="width: 100%; padding: 20px 15px; background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 8px; text-align: center; box-sizing: border-box;">
              <p style="margin: 0 0 6px 0; font-size: 22px;">😔</p>
              <p style="margin: 0; font-size: 16px; font-weight: bold; color: #374151;">今回は惜しくも落選となりました</p>
              <p style="margin: 8px 0 0 0; font-size: 13px; color: #6b7280;">厳正なる抽選の結果、落選となりました。またの応募をお待ちしております。</p>
            </div>
          <% end %>
        <% else %>
          <%# 抽選前：情報リッチカード %>
          <div style="border: 1.5px solid #6ee7b7; border-radius: 10px; overflow: hidden; box-sizing: border-box; width: 100%;">
            <div style="background-color: #059c43; padding: 16px; text-align: center;">
              <p style="margin: 0 0 6px 0; font-size: 24px;">✅</p>
              <p style="margin: 0 0 4px 0; color: #ffffff; font-weight: 700; font-size: 16px;">応募受付完了！</p>
              <p style="margin: 0; color: rgba(255,255,255,0.8); font-size: 12px;"><%= l my_entry.created_at.in_time_zone('Asia/Tokyo'), format: :short %> に受け付けました</p>
            </div>
            <div style="background-color: #ffffff; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; background-color: #f3f4f6; border-radius: 6px;">
                <span style="font-size: 12px; color: #6b7280;">抽選予定</span>
                <span style="font-size: 12px; font-weight: 600; color: #111827;">
                  <% if @event.scheduled? %>
                    <%= l @event.lottery_scheduled_at, format: :short %>
                  <% else %>
                    <%= l @event.entry_end_at, format: :short %>（締切と同時）
                  <% end %>
                </span>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; background-color: #f3f4f6; border-radius: 6px;">
                <span style="font-size: 12px; color: #6b7280;">当選枠</span>
                <span style="font-size: 12px; font-weight: 600; color: #111827;"><%= @event.winner_count %> 名</span>
              </div>
              <div style="padding: 8px 10px; background-color: #ecfdf5; border-radius: 6px; display: flex; align-items: flex-start; gap: 8px;">
                <span style="font-size: 14px; flex-shrink: 0; line-height: 1.5;">💬</span>
                <p style="margin: 0; font-size: 11px; color: #065f46; line-height: 1.6;">抽選結果はLINEにお知らせします。通知をオフにしている場合はこのページでご確認ください。</p>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <%= form_with url: entries_path, method: :post, html: { id: 'entry-form' } do |f| %>
          <%= hidden_field_tag :event_token, @event.public_token %>
          <%= hidden_field_tag :recaptcha_token, '', id: 'recaptcha_token' %>
          <button type="submit"
                  id="entry-submit-btn"
                  class="entry-btn"
                  style="width: 100%; padding: 15px; background-color: #06C755; color: #ffffff; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer;">
            <span class="btn-spinner"></span>
            <span class="btn-text">このイベントに応募する</span>
          </button>
        <% end %>
      <% end %>
    <% else %>
      <%# ② LINEのみ完了 → SMS認証へ %>
      <%= link_to new_sms_verification_path(event_token: @event.public_token),
            style: "display: block; width: 100%; padding: 15px; background-color: #1d4ed8; color: #ffffff; border: none; border-radius: 8px; font-weight: bold; text-align: center; text-decoration: none; box-sizing: border-box;" do %>
        SMS認証へ進む →
      <% end %>
    <% end %>
  <% else %>
    <%# ① 未ログイン → LINEログインボタン %>
    <button id="line-login-btn" onclick="startLineLogin()" style="width: 100%; padding: 15px; background-color: #06C755; color: #ffffff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">
      LINEでログインして応募する
    </button>
  <% end %>
</div>

<script>
  const LIFF_APP_URL = "https://liff.line.me/<%= ENV['LIFF_ID'] %>/events/<%= @event.public_token %>";

  let liffPromise = null;
  let registrationStarted = false; // 二重実行防止フラグ

  async function ensureLiffInitialized() {
    if (liffPromise) return liffPromise;
    liffPromise = liff.init({ liffId: "<%= ENV['LIFF_ID'] %>" });
    return liffPromise;
  }

  async function initializeOnLoad() {
    try {
      await ensureLiffInitialized();

      if (!liff.isInClient()) {
        // 外部ブラウザ（Safari等）：ボタンのonclickをawaitなしの同期リダイレクトに差し替える
        // iOS Universal Links はユーザー操作と同期したnavigationでないと動作しないため
        const loginBtn = document.getElementById("line-login-btn");
        if (loginBtn) {
          loginBtn.innerText = "LINEアプリで開く";
          loginBtn.onclick = function() {
            window.location.href = LIFF_APP_URL;
          };
        }
        return;
      }

      // LINE内ブラウザ：ログイン済みならそのまま登録処理へ
      if (liff.isLoggedIn()) {
        const loginBtn = document.getElementById("line-login-btn");
        if (loginBtn) {
          processDirectRegistration(loginBtn);
        }
      }
    } catch (err) {
      console.error("LIFF初期化エラー:", err);
    }
  }

  async function startLineLogin() {
    const loginBtn = document.getElementById("line-login-btn");
    loginBtn.disabled = true;
    loginBtn.innerText = "通信中...";

    try {
      await ensureLiffInitialized();

      if (!liff.isInClient()) {
        // 外部ブラウザ → LINEアプリ内でこのページを開き直す
        window.location.href = LIFF_APP_URL;
        return;
      }

      if (liff.isLoggedIn()) {
        processDirectRegistration(loginBtn);
      } else {
        // LINE内ブラウザで未ログインの場合（通常は起きない）
        liff.login({ redirectUri: window.location.origin + window.location.pathname });
      }
    } catch (err) {
      console.error(err);
      loginBtn.disabled = false;
      loginBtn.innerText = "LINEでログインして応募する";
    }
  }

  async function processDirectRegistration(loginBtn) {
    if (registrationStarted) return; // 二重実行をブロック
    registrationStarted = true;

    loginBtn.innerText = "ユーザー情報を登録中...";
    loginBtn.disabled = true;

    try {
      const [accessToken, profile] = await Promise.all([
        liff.getAccessToken(),
        liff.getProfile()
      ]);

      const response = await fetch('/line_users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_token: accessToken,
          name: profile.displayName,
          picture_url: profile.pictureUrl
        })
      });

      const data = await response.json();

      if (response.ok && data.status === 'success') {
        window.location.replace(window.location.origin + window.location.pathname);
      } else if (response.status === 401) {
        // トークン期限切れ → logout()を挟まずそのまま再認証
        // logout()を挟むとLIFFセッションが壊れてgetAccessToken()がnullになる
        liff.login({ redirectUri: window.location.origin + window.location.pathname });
      } else {
        console.error("登録失敗:", data.message);
        registrationStarted = false;
        loginBtn.disabled = false;
        loginBtn.innerText = "LINEでログインして応募する";
      }
    } catch (err) {
      console.error("通信エラー:", err);
      registrationStarted = false;
      loginBtn.disabled = false;
      loginBtn.innerText = "LINEでログインして応募する";
    }
  }

  if (document.readyState !== "loading") { initializeOnLoad(); }

  // 当選カードが表示されている場合のみ紙吹雪を起動
  (function() {
    if (!document.getElementById('win-card')) return;

    const COLORS = ['#fbbf24','#34d399','#60a5fa','#f472b6','#a78bfa','#fb923c'];
    const canvas = document.createElement('canvas');
    canvas.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999;';
    document.body.appendChild(canvas);
    const ctx = canvas.getContext('2d');

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    const pieces = Array.from({ length: 70 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * -canvas.height,
      r: Math.random() * 5 + 3,
      speed: Math.random() * 2 + 1.5,
      drift: (Math.random() - 0.5) * 1.5,
      tilt: 0,
      tiltInc: Math.random() * 0.08 + 0.04,
      color: COLORS[Math.floor(Math.random() * COLORS.length)]
    }));

    let angle = 0;
    const start = Date.now();
    let raf;

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      angle += 0.008;
      const elapsed = Date.now() - start;
      const alpha = elapsed < 2200 ? 1 : Math.max(0, 1 - (elapsed - 2200) / 500);

      pieces.forEach(p => {
        p.tilt += p.tiltInc;
        p.y += p.speed + Math.cos(angle + p.speed) * 0.5;
        p.x += p.drift + Math.sin(angle) * 0.8;

        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.ellipse(p.x, p.y, p.r, p.r / 2, p.tilt, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.fill();
        ctx.restore();
      });

      if (elapsed < 2700) {
        raf = requestAnimationFrame(draw);
      } else {
        canvas.remove();
      }
    }

    // カードのアニメーションが始まる少し後に起動
    setTimeout(() => { raf = requestAnimationFrame(draw); }, 300);
  })();

  // 応募締切カウントダウン
  (function() {
    const el = document.getElementById('countdown-timer');
    if (!el) return;
    const deadline = new Date(el.dataset.deadline);

    function pad(n) { return String(n).padStart(2, '0'); }

    function tick() {
      const diff = deadline - Date.now();
      if (diff <= 0) {
        el.closest('#countdown-bar').remove();
        return;
      }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      el.textContent = d > 0
        ? `${d}日 ${pad(h)}:${pad(m)}:${pad(s)}`
        : `${pad(h)}:${pad(m)}:${pad(s)}`;

      // 残り1時間を切ったら文字色を強調
      if (diff < 3600000) {
        el.style.color = '#dc2626';
        el.closest('#countdown-bar').style.backgroundColor = '#fef2f2';
        el.closest('#countdown-bar').style.borderColor = '#fca5a5';
      }
    }
    tick();
    setInterval(tick, 1000);
  })();

  // reCAPTCHA v3: フォーム送信前にトークンを取得してから送信
  const entryForm = document.getElementById('entry-form');
  if (entryForm) {
    entryForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('entry-submit-btn');
      btn.disabled = true;
      btn.classList.add('loading');
      btn.querySelector('.btn-text').textContent = '応募処理中…';

      try {
        const token = await grecaptcha.execute('<%= ENV['RECAPTCHA_SITE_KEY'] %>', { action: 'entry' });
        document.getElementById('recaptcha_token').value = token;
        entryForm.submit();
      } catch (err) {
        // reCAPTCHAが失敗しても応募は継続（サーバー側で空トークンとして処理）
        console.error('reCAPTCHA error:', err);
        entryForm.submit();
      }
    });
  }
</script>