<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
  <% if @event.image.attached? %>
    <%= image_tag @event.image, style: "width: 100%; border-radius: 8px; margin-bottom: 20px;" %>
  <% end %>

  <h1 style="font-size: 24px; font-weight: bold; margin-bottom: 10px;"><%= @event.title %></h1>
  
  <div style="background-color: #f3f4f6; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
    <p style="margin: 0; font-size: 14px; color: #4b5563;">受付期間</p>
    <p style="margin: 5px 0 0 0; font-weight: bold;">
      <%= l @event.start_at, format: :short %> 〜 <%= l @event.end_at, format: :short %>
    </p>
  </div>

  <div style="margin-bottom: 30px; line-height: 1.6;">
    <%= simple_format(@event.description) %>
  </div>

  <%# 今後ここにLINEログイン＋SMS認証のエントリーボタンを実装します %>
  <button style="width: 100%; padding: 15px; background-color: #d1d5db; color: #4b5563; border: none; border-radius: 8px; font-weight: bold; cursor: not-allowed;" disabled>
    LINEでログインして応募する（準備中）
  </button>
</div>