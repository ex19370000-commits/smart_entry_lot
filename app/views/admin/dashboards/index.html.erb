<% content_for :breadcrumb, 'ダッシュボード' %>

<%# ── サマリーカード ── %>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 0 0 8px;">応募率（全期間）</p>
    <p style="font-size: 32px; font-weight: 700; margin: 0; color: var(--admin-accent);"><%= @entry_rate %><span style="font-size: 16px;">%</span></p>
    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 6px 0 0;">訪問者のうち応募した割合</p>
  </div>
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 0 0 8px;">SMS認証完了率</p>
    <p style="font-size: 32px; font-weight: 700; margin: 0; color: #60a5fa;"><%= @sms_verify_rate %><span style="font-size: 16px;">%</span></p>
    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 6px 0 0;">LINEログイン後にSMS認証済み</p>
  </div>
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 0 0 8px;">イベント数</p>
    <p style="font-size: 32px; font-weight: 700; margin: 0; color: #facc15;"><%= @active_events.size %><span style="font-size: 16px;">件</span></p>
    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 6px 0 0;">公開・終了イベント合計</p>
  </div>
</div>

<%# ── 期間フィルタ ── %>
<div style="display: flex; gap: 8px; margin-bottom: 20px;">
  <% [['7days', '過去7日'], ['today', '今日'], ['week', '今週'], ['month', '今月']].each do |value, label| %>
    <%= link_to admin_dashboard_path(period: value),
          style: "padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; text-decoration: none; #{@period == value ? 'background-color: var(--admin-accent); color: #020617;' : 'background-color: var(--admin-bg-panel); color: var(--admin-text-muted); border: 1px solid var(--admin-border);'}" do %>
      <%= label %>
    <% end %>
  <% end %>
</div>

<%# ── グラフ ── %>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <h2 style="font-size: 16px; font-weight: 600; margin: 0 0 16px;">アクセス数</h2>
    <canvas id="accessChart"
            data-labels="<%= @labels.to_json %>"
            data-values="<%= @chart_access.to_json %>"
            style="max-height: 200px;"></canvas>
  </div>
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <h2 style="font-size: 16px; font-weight: 600; margin: 0 0 16px;">応募者数</h2>
    <canvas id="entriesChart"
            data-labels="<%= @labels.to_json %>"
            data-values="<%= @chart_entries.to_json %>"
            style="max-height: 200px;"></canvas>
  </div>
</div>

<script>
  (function() {
    function buildChart(id, color) {
      const el = document.getElementById(id);
      if (!el) return;
      new Chart(el, {
        type: 'bar',
        data: {
          labels: JSON.parse(el.dataset.labels),
          datasets: [{
            data: JSON.parse(el.dataset.values),
            backgroundColor: color,
            borderRadius: 4,
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: '#94a3b8', font: { size: 11 } }, grid: { color: 'rgba(255,255,255,0.05)' } },
            y: { ticks: { color: '#94a3b8', font: { size: 11 }, stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
          }
        }
      });
    }
    buildChart('accessChart',  '#10b981');
    buildChart('entriesChart', '#60a5fa');
  })();
</script>

<%# ── イベント一覧 ── %>
<div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px; margin-bottom: 30px;">
  <h2 style="font-size: 16px; font-weight: 600; margin: 0 0 16px;">イベント一覧</h2>
  <% if @active_events.any? %>
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>イベント名</th>
            <th>ステータス</th>
            <th>応募締切</th>
            <th>残り日数</th>
            <th>応募者数</th>
          </tr>
        </thead>
        <tbody>
          <% @active_events.each do |event| %>
            <% days_left = (event.entry_end_at.to_date - Date.today).to_i %>
            <tr>
              <td>
                <%= link_to event.title, admin_event_path(event), style: "color: var(--admin-accent); text-decoration: none;" %>
                <%= link_to dashboard_admin_event_path(event), style: "font-size: 11px; color: var(--admin-text-muted); text-decoration: none; margin-left: 8px;" do %>
                  <i class="fa-solid fa-chart-line"></i>
                <% end %>
              </td>
              <td><span class="badge badge-<%= event.lottery_status %>"><%= event.lottery_status_i18n %></span></td>
              <td style="font-size: 13px; color: var(--admin-text-muted);"><%= l event.entry_end_at, format: :short %></td>
              <td>
                <% if event.closed? %>
                  <span style="font-size: 13px; color: var(--admin-text-muted);">—</span>
                <% elsif days_left <= 1 %>
                  <span style="color: #f87171; font-weight: 600; font-size: 13px;"><%= days_left <= 0 ? '本日締切' : "残り#{days_left}日" %></span>
                <% else %>
                  <span style="font-size: 13px;">残り <%= days_left %> 日</span>
                <% end %>
              </td>
              <td style="text-align: center;"><%= event.entries.size %> 名</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p style="color: var(--admin-text-muted); font-size: 14px; margin: 0;">イベントがありません</p>
  <% end %>
</div>

<%# ── 下段2カラム ── %>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
  <%# 直近の応募アクティビティ %>
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <h2 style="font-size: 16px; font-weight: 600; margin: 0 0 16px;">直近の応募</h2>
    <% if @recent_entries.any? %>
      <% @recent_entries.each do |entry| %>
        <div style="display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--admin-border);">
          <% if entry.user&.picture_url.present? %>
            <img src="<%= entry.user.picture_url %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex-shrink: 0;">
          <% else %>
            <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #06C755; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <span style="color: #fff; font-size: 13px; font-weight: bold;"><%= entry.user&.display_name&.first %></span>
            </div>
          <% end %>
          <div style="flex: 1; min-width: 0;">
            <p style="margin: 0; font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= entry.user&.display_name %></p>
            <p style="margin: 2px 0 0; font-size: 11px; color: var(--admin-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= entry.event&.title %></p>
          </div>
          <span style="font-size: 11px; color: var(--admin-text-muted); white-space: nowrap;"><%= l entry.created_at, format: :short %></span>
        </div>
      <% end %>
    <% else %>
      <p style="color: var(--admin-text-muted); font-size: 14px; margin: 0;">応募データがありません</p>
    <% end %>
  </div>

  <%# イベント別応募数ランキング %>
  <div style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px;">
    <h2 style="font-size: 16px; font-weight: 600; margin: 0 0 16px;">応募数ランキング</h2>
    <% if @event_ranking.any? %>
      <% @event_ranking.each_with_index do |event, i| %>
        <% max_count = @event_ranking.first.entries_count.to_f %>
        <div style="margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70%;">
              <span style="color: var(--admin-text-muted); margin-right: 6px;">#<%= i + 1 %></span><%= event.title %>
            </span>
            <span style="font-size: 13px; font-weight: 600; white-space: nowrap;"><%= event.entries_count %> 名</span>
          </div>
          <div style="background-color: var(--admin-bg-dark); border-radius: 4px; height: 6px;">
            <div style="width: <%= (event.entries_count.to_f / max_count * 100).round %>%; background-color: var(--admin-accent); height: 100%; border-radius: 4px;"></div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p style="color: var(--admin-text-muted); font-size: 14px; margin: 0;">応募データがありません</p>
    <% end %>
  </div>
</div>
