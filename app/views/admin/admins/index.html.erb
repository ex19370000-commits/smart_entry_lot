<% content_for :breadcrumb, '管理画面 / 店舗管理' %>
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 12px;">
  <h1 style="font-size: 24px; font-weight: 700;">店舗管理</h1>

  <div style="display: flex; gap: 10px; align-items: center;">
    <%= form_with url: admin_admins_path, method: :get, local: true, style: "display: flex; gap: 8px;" do %>
      <input type="hidden" name="sort" value="<%= @sort %>">
      <input type="hidden" name="direction" value="<%= @direction %>">
      <input type="text" name="q" value="<%= @q %>" placeholder="表示名・メールアドレスで検索"
             style="width: 240px; background-color: var(--admin-bg-dark); border: 1px solid rgba(255, 255, 255, 0.35); border-radius: 8px; padding: 10px 15px; color: var(--admin-text-main); font-family: inherit; font-size: 15px; color-scheme: dark;">
      <button type="submit" class="btn-primary">検索</button>
    <% end %>
    <%= link_to new_admin_admin_path, class: "btn-primary" do %>
      <i class="fa-solid fa-user-plus"></i>
      <span>店舗アカウント発行</span>
    <% end %>
  </div>
</div>

<div class="admin-table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>
          <%= link_to "表示名", admin_admins_path(q: @q, sort: 'display_name', direction: (@sort == 'display_name' && @direction == 'asc') ? 'desc' : 'asc'), style: "color: inherit;" %>
        </th>
        <th>メールアドレス</th>
        <th>イベント数</th>
        <th>
          <%= link_to "登録日", admin_admins_path(q: @q, sort: 'created_at', direction: (@sort == 'created_at' && @direction == 'asc') ? 'desc' : 'asc'), style: "color: inherit;" %>
        </th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if @store_admins.any? %>
        <% @store_admins.each do |admin| %>
          <tr>
            <td style="font-weight: 600;"><%= admin.display_name %></td>
            <td style="color: var(--admin-text-muted);"><%= admin.email %></td>
            <td style="font-size: 13px;">
              <span style="color: #4ade80;">公開 <%= admin.events.published.count %> 件</span>
              <span style="color: var(--admin-text-muted); margin: 0 4px;">/</span>
              <span style="color: #f87171;">終了 <%= admin.events.closed.count %> 件</span>
            </td>
            <td style="font-size: 13px; color: var(--admin-text-muted);"><%= l admin.created_at, format: :short %></td>
            <td>
              <div class="admin-action-links">
                <% event_count = admin.events.size %>
                <% confirm_message = if event_count.positive?
                     "「#{admin.display_name}」には #{event_count} 件のイベントが紐づいています。\\n削除するとイベント・応募データもすべて削除されます。\\n本当に削除しますか？"
                   else
                     "「#{admin.display_name}」を削除しますか？"
                   end %>
                <%= button_to admin_admin_path(admin), method: :delete,
                      form: { onsubmit: "return confirm('#{confirm_message}')" },
                      style: "background: none; border: none; padding: 0; cursor: pointer;" do %>
                  <i class="fa-solid fa-trash" style="color: #f87171;"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" style="text-align: center; color: var(--admin-text-muted); padding: 40px;">
            店舗アカウントはまだありません
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
