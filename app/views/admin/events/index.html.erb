<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
  <h1 style="font-size: 24px; font-weight: 700;">イベント一覧</h1>
  
  <%= link_to new_admin_event_path, class: "btn-primary" do %>
    <i class="fa-solid fa-plus"></i>
    <span>新規イベント作成</span>
  <% end %>
</div>

<div class="admin-table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width: 80px;">画像</th>
        <th>タイトル</th>
        <th>ステータス</th>
        <th>抽選ステータス</th>
        <th>応募者数</th>
        <th>当選者数 / 抽選枠数</th>
        <th>開催期間</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <%# 画像サムネイル列 %>
          <td>
            <% if event.image.attached? %>
              <%= image_tag event.image.variant(resize_to_limit: [100, 100]), class: "admin-table-thumb" %>
            <% else %>
              <div class="no-image-placeholder">No Image</div>
            <% end %>
          </td>

          <%# タイトル列 %>
          <td style="font-weight: 600;"><%= event.title %></td>

          <%# ステータス列 %>
          <td>
            <span class="badge badge-<%= event.lottery_status %>">
              <%= event.lottery_status_i18n %>
            </span>
          </td>

          <%# 抽選ステータス列 %>
          <td>
            <% if event.already_drawn? %>
              <span style="background-color: #052e16; color: #4ade80; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 12px; white-space: nowrap;">
                <i class="fa-solid fa-circle-check"></i> 抽選済み
              </span>
            <% elsif event.closed? %>
              <span style="background-color: #1f2937; color: #f59e0b; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 12px; white-space: nowrap;">
                <i class="fa-solid fa-hourglass-half"></i> 未抽選
              </span>
            <% else %>
              <span style="color: #6b7280; font-size: 12px;">—</span>
            <% end %>
          </td>

          <%# 応募者数列 %>
          <td style="text-align: center; font-size: 14px; color: var(--admin-text);">
            <%= event.entries.size %> 名
          </td>

          <%# 当選者数 / 抽選枠数列 %>
          <td style="font-size: 14px; white-space: nowrap; text-align: center;">
            <% if event.already_drawn? %>
              <span style="color: var(--admin-text); font-weight: 600;"><%= event.entries.count(&:win?) %> 名</span>
              <span style="color: #6b7280;"> / </span>
              <span style="color: var(--admin-text-muted);"><%= event.winner_count %> 名</span>
            <% else %>
              <span style="color: #6b7280;">— / <%= event.winner_count %> 名</span>
            <% end %>
          </td>

          <%# 開催期間列 %>
          <td style="font-size: 13px; color: var(--admin-text-muted);">
            <%= l event.entry_start_at, format: :short %> 〜 <br>
            <%= l event.entry_end_at, format: :short %>
          </td>

          <%# 操作ボタン列 %>
          <td>
            <div class="admin-action-links">
              <%# 1. 詳細ボタン（QRコード確認用・緑色） %>
              <%= link_to admin_event_path(event), style: "color: #10b981;" do %>
                <i class="fa-solid fa-eye"></i>
              <% end %>

              <%# 2. 編集ボタン %>
              <%= link_to edit_admin_event_path(event), style: "color: #60a5fa;" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>
              
              <%# 3. 削除ボタン（button_toに変更） %>
              <%= button_to admin_event_path(event), method: :delete, form: { data: { turbo_confirm: "本当に削除しますか？" } }, style: "background: none; border: none; padding: 0; cursor: pointer;" do %>
                <i class="fa-solid fa-trash" style="color: #f87171;"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>