<% content_for :breadcrumb, '管理画面 / イベント詳細' %>
<div class="admin-card" style="max-width: 900px;">

  <%# ヘッダー：タイトル・ステータス・抽選状態を一行に %>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; gap: 16px; flex-wrap: wrap;">
    <h1 class="admin-title" style="margin-bottom: 0;"><%= @event.title %></h1>

    <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
      <span class="badge badge-<%= @event.lottery_status %>"><%= @event.lottery_status_i18n %></span>

      <% if @event.already_drawn? %>
        <span style="background-color: #052e16; color: #4ade80; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 12px; white-space: nowrap;">
          <i class="fa-solid fa-circle-check"></i> 抽選済み <%= l @event.lottery_executed_at, format: :short %>
        </span>

        <span id="notification-status-badge"
              data-status-url="<%= notification_status_admin_event_path(@event) %>"
              style="font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 12px; white-space: nowrap; background-color: #1f2937; color: #9ca3af;">
          <i class="fa-solid fa-spinner fa-spin"></i> LINE通知 確認中…
        </span>
      <% elsif @event.closed? %>
        <button id="draw-lottery-btn"
                data-url="<%= draw_lottery_admin_event_path(@event) %>"
                class="btn-primary"
                style="font-size: 13px; padding: 6px 16px;">
          <i class="fa-solid fa-shuffle"></i> 今すぐ実行
        </button>
      <% end %>
    </div>
  </div>

  <div style="display: flex; gap: 40px; flex-wrap: wrap;">
    <%# 左側：イベントの基本情報 %>
    <div style="flex: 1; min-width: 300px;">
      <% if @event.image.attached? %>
        <%= image_tag @event.image, style: "width: 100%; max-height: 300px; object-fit: cover; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--admin-border);" %>
      <% end %>

      <div style="background-color: var(--admin-bg-dark); padding: 20px; border-radius: 8px; border: 1px solid var(--admin-border);">
        <%# 応募期間・当選枠数・応募者数を横並びグリッドで表示 %>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--admin-border);">
          <div>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 4px;">応募開始</p>
            <p style="font-size: 14px; font-weight: 600;"><%= l @event.entry_start_at, format: :short %></p>
          </div>
          <div>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 4px;">応募締切</p>
            <p style="font-size: 14px; font-weight: 600;"><%= l @event.entry_end_at, format: :short %></p>
          </div>
          <div>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 4px;">当選枠数</p>
            <p style="font-size: 14px; font-weight: 600;"><%= @event.winner_count %> 名</p>
          </div>
        </div>

        <div style="margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--admin-border);">
          <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 4px;">抽選タイミング</p>
          <% if @event.scheduled? %>
            <p style="font-size: 14px; font-weight: 600;">
              <i class="fa-solid fa-clock" style="color: var(--admin-accent);"></i>
              スケジューリング抽選：<%= l @event.lottery_scheduled_at, format: :short %>
            </p>
          <% else %>
            <p style="font-size: 14px; font-weight: 600;">
              <i class="fa-solid fa-bolt" style="color: #facc15;"></i>
              応募締切と同時に抽選
            </p>
          <% end %>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--admin-border);">
          <div>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 4px;">応募者数</p>
            <p style="font-size: 22px; font-weight: 700;"><%= @event.entries.count %> <span style="font-size: 14px; font-weight: 400;">名</span></p>
          </div>
          <% if @event.already_drawn? %>
            <div>
              <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 4px;">当選者数</p>
              <p style="font-size: 22px; font-weight: 700; color: #4ade80;"><%= @event.entries.win.count %> <span style="font-size: 14px; font-weight: 400; color: var(--admin-text-muted);">名 / <%= @event.winner_count %>名枠</span></p>
            </div>
          <% end %>
        </div>

        <h3 style="font-size: 14px; color: var(--admin-text-muted); margin-bottom: 10px;">イベント詳細</h3>
        <p style="white-space: pre-wrap; font-size: 15px; line-height: 1.6;"><%= @event.description %></p>
      </div>
    </div>

    <%# 右側：QRコード・URL情報 %>
    <div style="width: 300px;">
      <div style="background-color: var(--admin-bg-dark); padding: 30px 20px; border-radius: 8px; border: 1px solid var(--admin-border); text-align: center;">
        <h2 style="font-size: 16px; margin-bottom: 20px; color: var(--admin-accent);">応募用QRコード</h2>

        <div style="background-color: white; padding: 15px; border-radius: 8px; display: inline-block; margin-bottom: 20px;">
          <%= raw @event.qr_code_svg %>
        </div>

        <div style="text-align: left; margin-bottom: 20px;">
          <label style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 5px; display: block;">応募用URL</label>
          <div style="display: flex; gap: 8px;">
            <input type="text" id="public-url" value="<%= @event.public_url %>" readonly class="form-control" style="font-size: 12px; flex: 1; text-align: left; text-overflow: ellipsis; padding-right: 8px; cursor: pointer;" onclick="this.select();">
            <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('public-url').value); alert('URLをコピーしました');" class="btn-primary" style="padding: 10px 15px;" title="URLをコピー">
              <i class="fa-solid fa-copy"></i>
            </button>
          </div>
        </div>

        <%= link_to "実際の応募ページを開く", @event.public_url, target: "_blank", class: "btn-secondary", style: "display: inline-block; font-size: 13px; margin-top: 10px;" %>
      </div>
    </div>
  </div>

  <%# 応募者一覧セクション %>
  <div style="margin-top: 40px; border-top: 1px solid var(--admin-border); padding-top: 30px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
      <h2 style="font-size: 18px; font-weight: 700; margin: 0;">
        応募者一覧
        <span style="font-size: 14px; font-weight: 400; color: var(--admin-text-muted); margin-left: 8px;"><%= @event.entries.count %> 名</span>
      </h2>
      <div style="display: flex; gap: 8px;">
        <%= link_to export_entries_admin_event_path(@event, format: :csv),
              class: "btn-secondary",
              style: "font-size: 13px; padding: 6px 14px;" do %>
          <i class="fa-solid fa-download"></i> 全応募者 CSV
        <% end %>
        <% if @event.already_drawn? %>
          <%= link_to export_entries_admin_event_path(@event, winners_only: true, format: :csv),
                class: "btn-secondary",
                style: "font-size: 13px; padding: 6px 14px;" do %>
            <i class="fa-solid fa-trophy"></i> 当選者 CSV
          <% end %>
        <% end %>
      </div>
    </div>

    <% entries = @event.entries.includes(:user).order(created_at: :asc) %>
    <% if entries.any? %>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ユーザー</th>
              <th>応募日時</th>
              <% if @event.already_drawn? %>
                <th>当落</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% entries.each do |entry| %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <% if entry.user&.picture_url.present? %>
                      <img src="<%= entry.user.picture_url %>" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; flex-shrink: 0;">
                    <% end %>
                    <%= entry.user&.display_name %>
                  </div>
                </td>
                <td style="font-size: 13px; color: var(--admin-text-muted); white-space: nowrap;">
                  <%= l entry.created_at, format: :short %>
                </td>
                <% if @event.already_drawn? %>
                  <td>
                    <% if entry.win? %>
                      <span style="background-color: #fef08a; color: #713f12; font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 12px;">当選</span>
                    <% else %>
                      <span style="background-color: #1f2937; color: #9ca3af; font-size: 12px; padding: 2px 10px; border-radius: 12px;">落選</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p style="color: var(--admin-text-muted); font-size: 14px;">まだ応募者がいません。</p>
    <% end %>
  </div>

  <div class="form-actions" style="margin-top: 30px; border-top: 1px solid var(--admin-border); padding-top: 20px;">
    <%= link_to admin_events_path, class: "btn-secondary" do %>
      <i class="fa-solid fa-arrow-left"></i> 一覧に戻る
    <% end %>
    <%= link_to edit_admin_event_path(@event), class: "btn-primary" do %>
      <i class="fa-solid fa-pen-to-square"></i> 編集する
    <% end %>
  </div>
</div>

<script>
  (function() {
    const btn = document.getElementById('draw-lottery-btn');
    if (!btn) return;

    btn.addEventListener('click', async function() {
      if (!confirm('抽選を実行しますか？この操作は取り消せません。')) return;

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 抽選実行中…';

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const res = await fetch(btn.dataset.url, {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        });
        const data = await res.json();
        if (res.ok) {
          window.location.href = data.redirect_url || window.location.pathname;
        } else {
          throw new Error(data.error || '抽選実行に失敗しました');
        }
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-shuffle"></i> 今すぐ実行';
      }
    });
  })();
</script>

<% if @event.already_drawn? %>
  <script>
    (function() {
      const badge = document.getElementById('notification-status-badge');
      if (!badge) return;

      const statusConfig = {
        success: { icon: 'fa-circle-check', text: 'LINE通知 送信完了', bg: '#052e16', color: '#4ade80' },
        error:   { icon: 'fa-circle-exclamation', text: 'LINE通知 送信失敗', bg: '#450a0a', color: '#f87171' },
        pending: { icon: 'fa-spinner fa-spin', text: 'LINE通知 送信中…', bg: '#1f2937', color: '#9ca3af' },
        unknown: { icon: 'fa-circle-question', text: 'LINE通知 状況不明', bg: '#1f2937', color: '#9ca3af' }
      };

      function applyStatus(status) {
        const config = statusConfig[status] || statusConfig.unknown;
        badge.innerHTML = `<i class="fa-solid ${config.icon}"></i> ${config.text}`;
        badge.style.backgroundColor = config.bg;
        badge.style.color = config.color;
      }

      function poll() {
        fetch(badge.dataset.statusUrl, { headers: { 'Accept': 'application/json' } })
          .then(res => res.json())
          .then(data => {
            applyStatus(data.status);
            if (data.status === 'pending' || data.status === 'unknown') {
              setTimeout(poll, 3000);
            }
          })
          .catch(() => setTimeout(poll, 5000));
      }

      poll();
    })();
  </script>
<% end %>
