<div class="admin-card">
  <h1 class="admin-title">新規イベント作成</h1>

  <%= form_with model: [:admin, @event], local: true do |f| %>
    <%# エラーメッセージの表示（バリデーションエラー用） %>
    <% if @event.errors.any? %>
      <div class="flash-message flash-alert">
        <ul style="margin: 0; padding-left: 20px;">
          <% @event.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, class: "form-control", placeholder: "例：春の感謝祭 大抽選会" %>
    </div>

    <div class="form-group">
      <%= f.label :image, "メイン画像（Active Storage）" %>
      <%= f.file_field :image, class: "form-control", accept: 'image/jpg,image/jpeg,image/png,image/gif' %>
      <small style="color: var(--admin-text-muted); display: block; margin-top: 5px;">
        ※jpg, png, gif形式がアップロード可能です
      </small>
    </div>

    <div class="form-group">
      <%= f.label :description %>
      <%= f.text_area :description, class: "form-control", placeholder: "イベントの詳細や景品情報を入力してください", rows: 5 %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :start_at %>
        <%= f.datetime_field :start_at, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :end_at %>
        <%= f.datetime_field :end_at, class: "form-control" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :status %>
      <%= f.select :status, Event.statuses_i18n.invert, {}, class: "form-control" %>
    </div>

    <div class="form-actions">
      <%= f.submit "イベントを保存する", class: "btn-primary" %>
      <%= link_to "キャンセル", admin_events_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>