<% content_for :breadcrumb, "チェックインスキャナー / #{@event.title}" %>

<div style="max-width: 520px; margin: 0 auto;">
  <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0;">チェックインスキャナー</h1>
    <span class="badge badge-<%= @event.lottery_status %>"><%= @event.lottery_status_i18n %></span>
  </div>

  <%# カメラビュー %>
  <div style="position: relative; background-color: #000; border-radius: 12px; overflow: hidden; margin-bottom: 20px;">
    <video id="scanner-video" autoplay playsinline muted style="width: 100%; display: block;"></video>
    <canvas id="scanner-canvas" style="display: none;"></canvas>

    <%# スキャン枠 %>
    <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;">
      <div style="width: 220px; height: 220px; border: 3px solid rgba(255,255,255,0.8); border-radius: 12px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.45);"></div>
    </div>

    <%# スキャン中ライン %>
    <div id="scan-line" style="position: absolute; left: calc(50% - 110px); width: 220px; height: 3px; background: linear-gradient(90deg, transparent, #10b981, transparent); border-radius: 2px; animation: scanline 2s linear infinite; display: none;"></div>
  </div>

  <%# 結果表示エリア %>
  <div id="scan-result" style="background-color: var(--admin-bg-panel); border: 1px solid var(--admin-border); border-radius: 12px; padding: 20px; min-height: 100px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
    <p style="color: var(--admin-text-muted); font-size: 14px; margin: 0; text-align: center;">
      <i class="fa-solid fa-camera" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>
      カメラを起動してQRコードをスキャンしてください
    </p>
  </div>

  <%# 操作ボタン %>
  <div style="display: flex; gap: 10px;">
    <button id="start-btn" class="btn-primary" style="flex: 1;">
      <i class="fa-solid fa-camera"></i> カメラ起動
    </button>
    <button id="stop-btn" class="btn-secondary" style="flex: 1; display: none;">
      <i class="fa-solid fa-stop"></i> 停止
    </button>
    <%= link_to admin_event_path(@event), class: "btn-secondary" do %>
      <i class="fa-solid fa-arrow-left"></i> 戻る
    <% end %>
  </div>
</div>

<style>
  @keyframes scanline {
    0%   { top: calc(50% - 110px); opacity: 1; }
    45%  { opacity: 1; }
    50%  { top: calc(50% + 107px); opacity: 0; }
    51%  { top: calc(50% - 110px); opacity: 0; }
    55%  { opacity: 1; }
    100% { top: calc(50% - 110px); opacity: 1; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
<script>
  (function() {
    const video      = document.getElementById('scanner-video');
    const canvas     = document.getElementById('scanner-canvas');
    const ctx        = canvas.getContext('2d');
    const resultBox  = document.getElementById('scan-result');
    const startBtn   = document.getElementById('start-btn');
    const stopBtn    = document.getElementById('stop-btn');
    const scanLine   = document.getElementById('scan-line');
    const verifyUrl  = '<%= verify_checkin_admin_event_path(@event) %>';
    const csrfToken  = document.querySelector('meta[name="csrf-token"]')?.content;

    let stream       = null;
    let scanning     = false;
    let lastToken    = null;
    let cooldown     = false;

    startBtn.addEventListener('click', startCamera);
    stopBtn.addEventListener('click', stopCamera);

    async function startCamera() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        video.srcObject = stream;
        scanning = true;
        startBtn.style.display = 'none';
        stopBtn.style.display  = '';
        scanLine.style.display = '';
        showMessage('スキャン中…', '#9ca3af', 'fa-spinner fa-spin');
        requestAnimationFrame(tick);
      } catch (err) {
        showMessage('カメラへのアクセスが拒否されました。ブラウザの設定を確認してください。', '#f87171', 'fa-circle-exclamation');
      }
    }

    function stopCamera() {
      scanning = false;
      stream?.getTracks().forEach(t => t.stop());
      video.srcObject = null;
      startBtn.style.display = '';
      stopBtn.style.display  = 'none';
      scanLine.style.display = 'none';
      showMessage('カメラを停止しました', '#9ca3af', 'fa-camera');
    }

    function tick() {
      if (!scanning) return;
      if (video.readyState === video.HAVE_ENOUGH_DATA) {
        canvas.width  = video.videoWidth;
        canvas.height = video.videoHeight;
        ctx.drawImage(video, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: 'dontInvert' });
        if (code && code.data && code.data !== lastToken && !cooldown) {
          lastToken = code.data;
          verifyToken(code.data);
        }
      }
      requestAnimationFrame(tick);
    }

    async function verifyToken(token) {
      cooldown = true;
      showMessage('確認中…', '#9ca3af', 'fa-spinner fa-spin');

      try {
        const res  = await fetch(verifyUrl, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body:    JSON.stringify({ token })
        });
        const data = await res.json();
        renderResult(data);
      } catch {
        showMessage('通信エラーが発生しました', '#f87171', 'fa-circle-exclamation');
      }

      // 3秒後に次のスキャンを受け付ける
      setTimeout(() => { cooldown = false; lastToken = null; }, 3000);
    }

    function renderResult(data) {
      if (data.status === 'success') {
        resultBox.innerHTML = `
          <div style="text-align: center; width: 100%;">
            ${data.picture_url
              ? `<img src="${data.picture_url}" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover; margin-bottom: 10px;">`
              : `<div style="width:56px;height:56px;border-radius:50%;background:#06C755;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><span style="color:#fff;font-size:22px;font-weight:bold;">${(data.user_name||'?')[0]}</span></div>`
            }
            <p style="font-size: 22px; font-weight: 700; color: #4ade80; margin: 0 0 4px;">✓ チェックイン完了</p>
            <p style="font-size: 16px; font-weight: 600; margin: 0;">${data.user_name || ''}</p>
          </div>`;
        resultBox.style.borderColor = '#4ade80';
        resultBox.style.backgroundColor = '#052e16';
      } else if (data.status === 'already_checked_in') {
        resultBox.innerHTML = `
          <div style="text-align: center; width: 100%;">
            <p style="font-size: 18px; font-weight: 700; color: #facc15; margin: 0 0 6px;"><i class="fa-solid fa-triangle-exclamation"></i> 既にチェックイン済み</p>
            <p style="font-size: 14px; margin: 0; color: var(--admin-text-muted);">${data.user_name || ''}</p>
            <p style="font-size: 12px; margin: 4px 0 0; color: var(--admin-text-muted);">${data.checked_in_at}</p>
          </div>`;
        resultBox.style.borderColor = '#ca8a04';
        resultBox.style.backgroundColor = '#422006';
      } else {
        resultBox.innerHTML = `
          <div style="text-align: center; width: 100%;">
            <p style="font-size: 18px; font-weight: 700; color: #f87171; margin: 0 0 6px;"><i class="fa-solid fa-circle-xmark"></i> 無効なQRコード</p>
            <p style="font-size: 13px; margin: 0; color: var(--admin-text-muted);">${data.message || ''}</p>
          </div>`;
        resultBox.style.borderColor = '#dc2626';
        resultBox.style.backgroundColor = '#450a0a';
      }
    }

    function showMessage(text, color, icon) {
      resultBox.innerHTML = `
        <p style="color: ${color}; font-size: 14px; margin: 0; text-align: center;">
          <i class="fa-solid ${icon}" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>
          ${text}
        </p>`;
      resultBox.style.borderColor = 'var(--admin-border)';
      resultBox.style.backgroundColor = 'var(--admin-bg-panel)';
    }
  })();
</script>
