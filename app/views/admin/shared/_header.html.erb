<header class="admin-header">
  <div class="header-left">
    <span class="breadcrumb"><%= content_for?(:breadcrumb) ? yield(:breadcrumb) : '管理画面' %></span>
  </div>
  <div class="header-right">
    <div class="admin-user-profile">
      <span><i class="fa-solid fa-user-gear"></i> <%= current_admin.display_name %></span>
      <%= button_to admin_logout_path, method: :delete, class: "logout-icon" do %>
        <i class="fa-solid fa-right-from-bracket"></i>
      <% end %>
    </div>
  </div>
</header>