<%# app/views/admin/shared/_sidebar.html.erb %>

<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <h2>Smart Entry <span>Lot</span></h2>
  </div>
  <nav class="sidebar-nav">
    <ul>
      <%# ダッシュボード %>
      <li class="<%= 'active' if current_page?(admin_dashboard_path) %>">
        <%= link_to admin_dashboard_path do %>
          <i class="fa-solid fa-gauge-high"></i> ダッシュボード
        <% end %>
      </li>

      <%# イベント管理 %>
      <li class="<%= 'active' if controller_name == 'events' %>">
        <%= link_to admin_events_path do %>
          <i class="fa-solid fa-calendar-check"></i> イベント管理
        <% end %>
      </li>

      <%# アクセスログ %>
      <li class="<%= 'active' if controller_name == 'access_logs' %>">
        <%= link_to admin_access_logs_path do %>
          <i class="fa-solid fa-shield-halved"></i> アクセスログ
        <% end %>
      </li>

      <% if current_admin.role_owner? %>
        <li class="<%= 'active' if controller_name == 'admins' %>">
          <%= link_to admin_admins_path do %>
            <i class="fa-solid fa-shop"></i> 店舗管理
          <% end %>
        </li>
        <li class="<%= 'active' if controller_name == 'admins' && action_name == 'new' %>">
          <%= link_to new_admin_admin_path do %>
            <i class="fa-solid fa-user-plus"></i> アカウント発行
          <% end %>
        </li>
        <li>
          <a href="#"><i class="fa-solid fa-users"></i> ユーザー管理</a>
        </li>
      <% end %>
    </ul>
  </nav>
</aside>