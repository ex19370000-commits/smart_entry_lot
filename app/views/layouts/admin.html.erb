<!DOCTYPE html>
<html>
  <head>
    <title>Smart Entry Lot - 管理画面</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%# プロ仕様のフォントとアイコンを読み込み %>
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;600&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <div class="admin-wrapper">
      <%# サイドバーを読み込み %>
      <%= render 'admin/shared/sidebar' %>

      <div class="admin-main-content">
        <%# ヘッダーを読み込み %>
        <%= render 'admin/shared/header' %>

        <main class="admin-view-container">
          <%# フラッシュメッセージ表示用 %>
          <%= render 'shared/flash_messages' %>
          
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>