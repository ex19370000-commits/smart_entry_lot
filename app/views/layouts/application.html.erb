<!DOCTYPE html>
<html>
  <head>
    <title>SmartEntryLot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% if current_user && !current_user.admin? %>
      <div style="text-align: right; padding: 8px 20px; background-color: #f9fafb; border-bottom: 1px solid #e5e7eb;">
        <%= button_to "ログアウト", logout_path, method: :delete,
              form: { id: "logout-form" },
              style: "background: none; border: none; color: #6b7280; font-size: 13px; cursor: pointer; text-decoration: underline;",
              onclick: "if(typeof liff !== 'undefined'){ try{ liff.logout(); }catch(e){} }" %>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div style="background-color: #d1fae5; color: #065f46; padding: 12px 20px; text-align: center; font-size: 14px; font-weight: bold;">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background-color: #fee2e2; color: #991b1b; padding: 12px 20px; text-align: center; font-size: 14px; font-weight: bold;">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
