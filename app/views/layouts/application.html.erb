<!DOCTYPE html>
<html>
  <head>
    <title>SmartEntryLot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        -webkit-tap-highlight-color: transparent;
        padding-bottom: env(safe-area-inset-bottom, 0);
      }
      footer {
        padding-bottom: max(24px, calc(env(safe-area-inset-bottom) + 24px));
      }
    </style>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% if current_user %>
      <div style="text-align: right; padding: 8px 20px; background-color: #f9fafb; border-bottom: 1px solid #e5e7eb;">
        <%= button_to "ログアウト", logout_path, method: :delete,
              form: { id: "logout-form" },
              style: "background: none; border: none; color: #6b7280; font-size: 13px; cursor: pointer; text-decoration: underline;",
              onclick: "if(typeof liff !== 'undefined'){ try{ liff.logout(); }catch(e){} }" %>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div style="background-color: #d1fae5; color: #065f46; padding: 12px 20px; text-align: center; font-size: 14px; font-weight: bold;">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background-color: #fee2e2; color: #991b1b; padding: 12px 20px; text-align: center; font-size: 14px; font-weight: bold;">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <%= yield %>
    <footer style="margin-top: 60px; padding: 24px 20px; border-top: 1px solid #e5e7eb; text-align: center; font-size: 13px; color: #9ca3af;">
      <%= link_to "プライバシーポリシー", privacy_policy_path, style: "color: #6b7280; text-decoration: none; margin: 0 12px;" %>
      <%= link_to "利用規約", terms_path, style: "color: #6b7280; text-decoration: none; margin: 0 12px;" %>
      <p style="margin: 12px 0 0;">&copy; <%= Time.current.year %> Smart Entry Lot</p>
    </footer>
  </body>
</html>
