<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
  <h1 style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">認証コードの入力</h1>

  <div style="background-color: #f3f4f6; padding: 15px; border-radius: 8px; margin-bottom: 24px;">
    <p style="margin: 0; font-size: 14px; color: #4b5563;">
      SMSに届いた6桁のコードを入力してください。<br>
      有効期限は送信から10分以内です。
    </p>
  </div>

  <% if flash[:alert] %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 12px 15px; border-radius: 8px; margin-bottom: 16px; font-size: 14px;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: confirm_sms_verifications_path, method: :post do |f| %>
    <%= hidden_field_tag :event_token, @event_token %>

    <div style="margin-bottom: 20px;">
      <label style="display: block; font-size: 14px; color: #4b5563; margin-bottom: 6px;">
        認証コード（6桁）
      </label>
      <%= f.text_field :code,
            placeholder: "123456",
            maxlength: 6,
            inputmode: "numeric",
            autocomplete: "one-time-code",
            style: "width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 24px; font-weight: bold; letter-spacing: 8px; text-align: center; box-sizing: border-box;",
            required: true %>
    </div>

    <%= f.submit "認証する",
          style: "width: 100%; padding: 15px; background-color: #06C755; color: #ffffff; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer;" %>
  <% end %>

  <div style="margin-top: 16px; text-align: center;">
    <%= link_to "SMSが届かない場合は再送する",
          new_sms_verification_path(event_token: @event_token),
          style: "font-size: 14px; color: #4b5563;" %>
  </div>
</div>
