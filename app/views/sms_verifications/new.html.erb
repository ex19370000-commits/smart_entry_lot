<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .sms-btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 15px;
    background-color: #06C755; color: #fff;
    border: none; border-radius: 8px;
    font-size: 16px; font-weight: bold; cursor: pointer;
    transition: transform 0.12s ease, opacity 0.12s ease, background-color 0.15s ease;
  }
  .sms-btn:active { transform: scale(0.97); opacity: 0.85; }
  .sms-btn .btn-spinner {
    display: none; width: 16px; height: 16px;
    border: 2px solid rgba(255,255,255,0.35); border-top-color: #fff;
    border-radius: 50%; flex-shrink: 0;
    animation: spin 0.7s linear infinite;
  }
  .sms-btn.loading { background-color: #059c43; cursor: not-allowed; }
  .sms-btn.loading .btn-spinner { display: block; }
  .sms-btn.loading .btn-icon { display: none; }
  .phone-input {
    width: 100%; padding: 13px 14px;
    border: 1.5px solid #d1d5db; border-radius: 8px;
    font-size: 18px; box-sizing: border-box;
    transition: border-color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .phone-input:focus { outline: none; border-color: #06C755; box-shadow: 0 0 0 3px rgba(6,199,85,0.15); }
</style>

<div style="max-width: 600px; margin: 0 auto; padding: 20px max(20px, env(safe-area-inset-right)) max(40px, calc(env(safe-area-inset-bottom) + 20px)) max(20px, env(safe-area-inset-left));">

  <%# ステップインジケーター %>
  <div style="display: flex; align-items: center; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 6px;">
      <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #06C755; display: flex; align-items: center; justify-content: center;">
        <span style="color: #fff; font-size: 12px; font-weight: 700;">✓</span>
      </div>
      <span style="font-size: 12px; color: #059c43; font-weight: 600;">LINEログイン</span>
    </div>
    <div style="flex: 1; height: 2px; background: linear-gradient(90deg, #06C755 50%, #d1d5db 50%); margin: 0 8px;"></div>
    <div style="display: flex; align-items: center; gap: 6px;">
      <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #06C755; display: flex; align-items: center; justify-content: center;">
        <span style="color: #fff; font-size: 11px; font-weight: 700;">2</span>
      </div>
      <span style="font-size: 12px; color: #059c43; font-weight: 600;">SMS認証</span>
    </div>
    <div style="flex: 1; height: 2px; background-color: #d1d5db; margin: 0 8px;"></div>
    <div style="display: flex; align-items: center; gap: 6px;">
      <div style="width: 22px; height: 22px; border-radius: 50%; background-color: #e5e7eb; display: flex; align-items: center; justify-content: center;">
        <span style="color: #9ca3af; font-size: 11px; font-weight: 700;">3</span>
      </div>
      <span style="font-size: 12px; color: #9ca3af;">応募</span>
    </div>
  </div>

  <h1 style="font-size: 22px; font-weight: bold; margin-bottom: 14px;">SMS認証</h1>

  <div style="background-color: #ecfdf5; border: 1px solid #6ee7b7; padding: 13px 14px; border-radius: 8px; margin-bottom: 20px; display: flex; gap: 10px; align-items: flex-start;">
    <span style="font-size: 16px; flex-shrink: 0; line-height: 1.5;">📱</span>
    <p style="margin: 0; font-size: 13px; color: #065f46; line-height: 1.6;">
      携帯電話番号にSMSで6桁の認証コードを送信します。<br>
      1つの電話番号につき1アカウントのみ登録できます。
    </p>
  </div>

  <% if flash[:alert] %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 12px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 13px;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: sms_verifications_path, method: :post, html: { id: 'sms-new-form' } do |f| %>
    <%= hidden_field_tag :event_token, @event_token %>

    <div style="margin-bottom: 20px;">
      <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 7px;">
        携帯電話番号
      </label>
      <%= f.telephone_field :phone_number,
            placeholder: "090-1234-5678",
            class: "phone-input",
            required: true %>
      <p style="margin: 6px 0 0 0; font-size: 12px; color: #6b7280;">ハイフンあり・なしどちらでも入力できます</p>
    </div>

    <button type="submit" class="sms-btn" id="sms-new-btn">
      <span class="btn-spinner"></span>
      <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 012 1.18 2 2 0 013.18 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.91 7.91a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
      </svg>
      <span class="btn-text">認証コードを送信する</span>
    </button>
  <% end %>
</div>

<script>
  document.getElementById('sms-new-form').addEventListener('submit', function() {
    const btn = document.getElementById('sms-new-btn');
    btn.classList.add('loading');
    btn.disabled = true;
    btn.querySelector('.btn-text').textContent = '送信中…';
  });
</script>
